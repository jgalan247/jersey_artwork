# Production Environment Variables for Jersey Artwork
# Copy this file to .env and fill in your production values

# Django Settings
DJANGO_SETTINGS_MODULE=artworks.settings_production
SECRET_KEY=your-secret-key-here-must-be-very-secure
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=jersey-artwork.ondigitalocean.app,www.jerseyartwork.com,jerseyartwork.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://jersey-artwork.ondigitalocean.app,https://www.jerseyartwork.com
CSRF_TRUSTED_ORIGINS=https://jersey-artwork.ondigitalocean.app,https://www.jerseyartwork.com

# Database (Digital Ocean Managed Database)
DATABASE_URL=postgresql://username:password@host:port/dbname?sslmode=require

# Redis Cache (Digital Ocean Managed Redis)
REDIS_URL=redis://default:password@redis-host:6379/0

# Digital Ocean Spaces (Object Storage)
USE_SPACES=true
SPACES_ACCESS_KEY_ID=your-spaces-access-key
SPACES_SECRET_ACCESS_KEY=your-spaces-secret-key
SPACES_BUCKET_NAME=jersey-artwork
SPACES_REGION=ams3
SPACES_CDN_DOMAIN=cdn.jerseyartwork.com

# Email Configuration (Google Workspace)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@jerseyartwork.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Jersey Artwork <noreply@jerseyartwork.com>
SERVER_EMAIL=Jersey Artwork Server <server@jerseyartwork.com>

# Admin Notifications (format: Name:email,Name2:email2)
ADMINS=Admin:admin@jerseyartwork.com,Support:support@jerseyartwork.com

# Payment Gateway - SumUp
PAYMENT_PROVIDER=sumup
SUMUP_BASE_URL=https://api.sumup.com
SUMUP_API_URL=https://api.sumup.com/v0.1
SUMUP_CLIENT_ID=your-sumup-client-id
SUMUP_CLIENT_SECRET=your-sumup-client-secret
SUMUP_MERCHANT_CODE=your-merchant-code
SUMUP_ACCESS_TOKEN=your-access-token
SUMUP_WEBHOOK_SECRET=your-webhook-secret
SUMUP_REDIRECT_URI=https://jerseyartwork.com/payments/sumup/callback/
SUMUP_SUCCESS_URL=/payments/success/
SUMUP_FAIL_URL=/payments/fail/

# Payment Gateway - CityPay (Alternative)
CITYPAY_BASE_URL=https://api.citypay.com
CITYPAY_MERCHANT_ID=your-citypay-merchant-id
CITYPAY_LICENCE=your-citypay-licence
CITYPAY_WEBHOOK_SECRET=your-citypay-webhook-secret

# Subscription Configuration
ARTIST_SUBSCRIPTION_PRICE=15.00
SUBSCRIPTION_CURRENCY=GBP
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_PERIOD=3
MAX_ARTWORKS_PER_ARTIST=100
FEATURED_LISTINGS=3

# Google reCAPTCHA
RECAPTCHA_PUBLIC_KEY=your-recaptcha-public-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Security Settings
SESSION_COOKIE_AGE=7200
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000